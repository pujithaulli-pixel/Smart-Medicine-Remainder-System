# =====================================================================
# Smart Medical Reminder System - Backend Environment Configuration
# =====================================================================

# Server Port
PORT=3001

# Phase 7: SQLite Database Path (Optional, defaults to server/data/medical_reminder.db)
# DB_PATH=server/data/medical_reminder.db

# Phase 7: Session Expiration in Days (Optional, defaults to 7 days)
# SESSION_TTL_DAYS=7

# Allow simulation for local automated test scripts
ALLOW_TEST_SIMULATION=false

# ---------------------------------------------------------------------
# Option A: Real SMTP Email Delivery (Gmail, Outlook, Amazon SES, etc.)
# ---------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# SMTP_FROM=alerts@smartmedicalreminder.org

# ---------------------------------------------------------------------
# Option B: SendGrid REST API Email Delivery
# ---------------------------------------------------------------------
# SENDGRID_API_KEY=SG.your_api_key_here

# ---------------------------------------------------------------------
# Option C: Twilio SMS Delivery
# ---------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=AC_your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ---------------------------------------------------------------------
# Option D: Generic Webhooks
# ---------------------------------------------------------------------
# EMAIL_WEBHOOK_URL=https://your-webhook-endpoint.com/email
# SMS_WEBHOOK_URL=https://your-webhook-endpoint.com/sms
